{
  "name": "worktree-hub",
  "displayName": "Worktree Hub",
  "description": "Conversations Claude Code groupées par worktree git, un clic pour ouvrir la conversation.",
  "version": "0.7.0",
  "publisher": "mathieulp",
  "private": true,
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeHub",
          "title": "Worktree Hub",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "worktreeHub": [
        {
          "type": "webview",
          "id": "worktreeHub.view",
          "name": "Sessions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "worktreeHub.refresh",
        "title": "Worktree Hub : rafraîchir",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeHub.update",
        "title": "Worktree Hub : redémarrer les extensions pour charger la mise à jour",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "worktreeHub.update",
          "when": "view == worktreeHub.view && worktreeHub.updateAvailable",
          "group": "navigation@1"
        },
        {
          "command": "worktreeHub.refresh",
          "when": "view == worktreeHub.view",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p . && node -e \"require('fs').writeFileSync('out/build.json', JSON.stringify({ builtAt: new Date().toISOString() }))\"",
    "watch": "tsc -w -p .",
    "package": "npm run build && vsce package --allow-missing-repository --skip-license -o worktree-hub.vsix",
    "install:codium": "npm run package && codium --install-extension worktree-hub.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
